{
	"schemaVersion": 1,
	"id": "fishmod-dungeons",
	"version": "${version}",
	"name": "FishMod (Dungeons Only)",
	"description": "Hypixel Skyblock dungeon utilities — curated Dungeons-only edition of FishMod",
	"authors": [
		"Redfish2471"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/${modrinthProject}",
		"sources": "https://github.com/${githubRepo}"
	},
	"license": "CC0-1.0",
	"icon": "assets/fishmod/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"fishmod.FishModInit"
		],
		"modmenu": [
			"fishmod.utils.config.ModMenu"
		]
	},
	"mixins": [
		"fishmod.mixins.json"
	],
	"custom": {
		"fishmod:updater": {
			"github": "${githubRepo}"
		}
	},
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.1.2",
		"java": ">=25",
		"fabric-api": "*",
		"hypixel-mod-api": "*",
		"immediatelyfast": "*"
	}
}
