+// ---- in-game inbox -----------------------------------------------------------
+async function getInbox(env) {
+  const ib = (await env.TESTBOARD.get(INBOX_KEY, "json")) || {};
+  if (!Array.isArray(ib.items)) ib.items = [];
+  return ib;
+}
+async function inboxSubmit(request, env) {
+  const len = Number(request.headers.get("content-length") || 0);
+  if (len > 16 * 1024) return jsonr({ error: "too big" }, 413);
+  let body;
+  try { body = await request.json(); } catch { return jsonr({ error: "bad json" }, 400); }
+  const kind = String(body && body.kind || "");
+  if (INBOX_KINDS.indexOf(kind) < 0) return jsonr({ error: "bad kind" }, 400);
+  const text = cleanMultiline(body.text, 2000);
+  const title = clean(body.title, 120);
+  if (!title && !text) return jsonr({ error: "empty" }, 400);
+  const key = kind === "auto" ? clean(body.key, 200) : "";
+  if (kind === "auto" && !key) return jsonr({ error: "no key" }, 400);
+  // Rate limit per hashed IP; the IP itself is never stored.
+  const ip = request.headers.get("cf-connecting-ip") || "?";
+  const rl = "inrl_" + (await hmac(ip, env.SESSION_SECRET || "inbox")).slice(0, 24);
+  const used = Number(await env.TESTBOARD.get(rl)) || 0;
+  if (used >= INBOX_PER_HOUR) return jsonr({ error: "rate" }, 429);
+  await env.TESTBOARD.put(rl, String(used + 1), { expirationTtl: 3600 });
+  const ib = await getInbox(env);
+  const now = Date.now();
+  const mod = clean(body.mod, 40);
+  if (key) {
+    const dup = ib.items.find(function (e) { return e.key === key; });
+    if (dup) {
+      dup.count = (dup.count || 1) + 1;
+      dup.last = now;
+      if (mod && dup.mods.indexOf(mod) < 0 && dup.mods.length < 10) dup.mods.push(mod);
+      await env.TESTBOARD.put(INBOX_KEY, JSON.stringify(ib));
+      return jsonr({ ok: true, dup: true });
+    }
+  }
+  const e = {
+    id: hex(6), kind: kind, title: title, text: text, key: key,
+    mods: mod ? [mod] : [], mc: clean(body.mc, 20), loc: clean(body.loc, 60),
+    log: cleanMultiline(body.log, 4000), count: 1, at: now, last: now,
+  };
+  ib.items.unshift(e);
+  if (ib.items.length > MAX_INBOX) ib.items.length = MAX_INBOX;
+  let out = JSON.stringify(ib);
+  while (out.length > MAX_BLOB_BYTES && ib.items.length > 1) {
+    ib.items.length = Math.max(1, ib.items.length - 20);
+    out = JSON.stringify(ib);
+  }
+  await env.TESTBOARD.put(INBOX_KEY, out);
+  return jsonr({ ok: true, id: e.id });
+}
